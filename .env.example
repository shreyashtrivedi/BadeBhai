# Copy to .env (optional: the defaults run a completely free, local stack). Never commit .env.

# --- LLM: free and local by default (Ollama + an open model) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:4b-instruct fits a 4 GB GPU. With more VRAM, larger instruct models (7-14B) answer better.
OLLAMA_MODEL=qwen3:4b-instruct
# Optional second model for decompose/grade/rewrite/memory (keep empty on small GPUs: swapping is slow)
OLLAMA_FAST_MODEL=
# Context window; evidence budgets scale with it. Raise it if your GPU has room.
OLLAMA_NUM_CTX=8192

# --- optional, free: GitHub token (issues/PRs: 60 req/h without one, 5,000 with a free token) ---
GITHUB_TOKEN=
# Secret configured on the GitHub webhook (POST /webhooks/github). Webhooks are rejected without it.
GITHUB_WEBHOOK_SECRET=

# --- optional, paid: Anthropic Claude instead of the local model ---
# uv sync --extra anthropic, then:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# --- embeddings (local, free) ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- storage (docker compose overrides these for containers) ---
DATABASE_URL=postgresql://repomind:repomind@localhost:5433/repomind_dev
DATA_DIR=./data

# --- MCP servers (http | stdio | inmemory) ---
MCP_TRANSPORT=http
MCP_CODE_SEARCH_URL=http://localhost:8101/mcp
MCP_GIT_HISTORY_URL=http://localhost:8102/mcp
MCP_DOCS_URL=http://localhost:8103/mcp

# --- live sync ---
# Poll every N seconds for new commits (0 = off; use webhooks or `repomind sync` instead)
SYNC_POLL_INTERVAL_S=0
# Ingest this repo on API startup if it is not indexed yet (owner/name@ref or URL)
AUTO_INGEST_REPO=

# --- guardrails (with LLM_PROVIDER=ollama, leaner defaults apply unless you set these) ---
# MAX_SUBQUESTIONS=3
# MAX_RETRIES=1
# MAX_TOOL_CALLS=24
MEMORY_IMPORTANCE_THRESHOLD=0.6

# --- tracing: local structured logs by default; LangSmith (hosted) is optional ---
LANGSMITH_TRACING=false
LOG_LEVEL=INFO
