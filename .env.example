# Copy to .env (optional: the defaults run a completely free, local stack). Never commit .env.

# --- LLM: free and local by default (Ollama + an open model) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:4b-instruct fits a 4 GB GPU. With more VRAM, larger instruct models (7-14B) answer better.
OLLAMA_MODEL=qwen3:4b-instruct
# Optional second model for decompose/grade/rewrite/memory (keep empty on small GPUs: swapping is slow)
OLLAMA_FAST_MODEL=
# Context window; evidence budgets scale with it. Raise it if your GPU has room.
OLLAMA_NUM_CTX=8192

# --- optional, free: GitHub token ---
# Needed for private repos; also raises GitHub's limit for issue/PR search from 60 to 5,000 requests/hour.
# Create one at https://github.com/settings/personal-access-tokens/new (for private repos: read-only
# Contents, Issues, Pull requests), paste it here, then restart BadeBhai.
GITHUB_TOKEN=
# Secret configured on the GitHub webhook (POST /webhooks/github). Webhooks are rejected without it.
GITHUB_WEBHOOK_SECRET=

# --- optional, paid: Anthropic Claude instead of the local model ---
# uv sync --extra anthropic, then:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# --- embeddings (local, free) ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- storage (docker compose overrides these for containers) ---
DATABASE_URL=postgresql://badebhai:badebhai@localhost:5433/badebhai_dev
DATA_DIR=./data

# --- MCP servers (http | stdio | inmemory) ---
MCP_TRANSPORT=http
MCP_CODE_SEARCH_URL=http://localhost:8101/mcp
MCP_GIT_HISTORY_URL=http://localhost:8102/mcp
MCP_DOCS_URL=http://localhost:8103/mcp

# --- live sync ---
# Poll every N seconds for new commits (0 = off; use webhooks or `badebhai sync` instead)
SYNC_POLL_INTERVAL_S=0
# Ingest this repo on API startup if it is not indexed yet (owner/name@ref or URL)
AUTO_INGEST_REPO=

# --- adding repos from the web page ---
# Allow the web page to add folders on this machine's disk (anyone who can open the page could then
# read them through BadeBhai). The CLI `badebhai ingest <folder>` always works.
API_ALLOW_LOCAL_PATHS=false
API_MAX_REPO_MB=2048

# --- guardrails (with LLM_PROVIDER=ollama, leaner defaults apply unless you set these) ---
# MAX_SUBQUESTIONS=3
# MAX_RETRIES=1
# MAX_TOOL_CALLS=24
MEMORY_IMPORTANCE_THRESHOLD=0.6

# --- speed ---
# Reuse an answer to the same question on the same commit of a repo for N hours (0 = off)
ANSWER_CACHE_TTL_HOURS=168
# Optional local reranker (e.g. BAAI/bge-reranker-base); off by default, see the README's Evaluation
RERANKER=

# --- tracing: local structured logs by default; LangSmith (hosted) is optional ---
LANGSMITH_TRACING=false
LOG_LEVEL=INFO

# --- accounts, for sharing one BadeBhai with a team (off: single-user local tool) ---
# Then: badebhai users add <you> --admin
AUTH_ENABLED=false
# SESSION_SECRET=   # long random string; without it everyone signs in again after a restart
# COOKIE_SECURE=true   # when served over HTTPS
# ASKS_PER_HOUR=60
# REPO_ADDS_PER_DAY=10
# MAX_PRIVATE_REPOS_PER_USER=10
